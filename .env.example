# ============================================================================
# IDX Intelligence Platform - environment configuration
# Copy this file to `.env` and fill in your secrets. NEVER commit the real .env.
# ============================================================================

# --- Qwen AI agent (OpenAI-compatible DashScope endpoint) -------------------
# Get a key from Alibaba Cloud Model Studio (DashScope). The key stays server-side.
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# --- SMTP (report email delivery) -------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=IDX Intelligence
SMTP_USE_TLS=true

# --- Application ------------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=5000
APP_DEBUG=false
# Preload ML models at startup (recommended for demos). true/false
WARMUP=true
# Keras backend for the .keras models (tensorflow matches how they were saved)
KERAS_BACKEND=tensorflow
TF_CPP_MIN_LOG_LEVEL=2
